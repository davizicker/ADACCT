; Engine configuration file.
config_version=5

[application]

config/name="Bradador"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

rendering_device/fallback_to_opengl3=true
rendering_device/fallback_to_vulkan=true

limits/opengl/max_renderable_lights=128
occlusion_culling/use_occlusion_culling=true
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48
lights_and_shadows/directional_shadow/size=2048

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
